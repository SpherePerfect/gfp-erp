rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.]+$');
    }

    // Admin authorization: checks if user document exists in admins collection or has verified primary admin email
    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email != null && request.auth.token.email.lower() == 'pratikyogeshkulkarni@gmail.com')
      );
    }

    // Helper to check if current user is the owner/creator
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Validation for User documents
    function isValidUser(data) {
      return data.uid is string &&
        data.email is string &&
        data.displayName is string && data.displayName.size() <= 120 &&
        data.role is string && (data.role in ['Admin', 'Partner', 'Associate', 'Viewer']) &&
        data.status is string && (data.status in ['Active', 'Suspended']) &&
        data.createdAt is string;
    }

    // USERS Collection
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isSignedIn();

      // First user bootstrap or admin can create user
      allow create: if isSignedIn() && isValidId(userId) && isValidUser(incoming()) && (
        isAdmin() ||
        isOwner(userId)
      );

      // Admin can update all fields including role and status; regular users can only update their own display name & photo
      allow update: if isSignedIn() && isValidId(userId) && isValidUser(incoming()) && (
        isAdmin() ||
        (
          isOwner(userId) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoUrl', 'phone', 'lastLoginAt', 'updatedAt']) &&
          incoming().role == existing().role &&
          incoming().status == existing().status
        )
      );

      allow delete: if isAdmin() && isValidId(userId);
    }

    // ADMINS Collection (Zero-Trust verification gate)
    match /admins/{adminId} {
      allow read: if isSignedIn() && isValidId(adminId);
      allow write: if isAdmin() && isValidId(adminId);
    }

    // ENGAGEMENTS Collection
    match /engagements/{engagementId} {
      allow get: if isSignedIn() && isValidId(engagementId);
      allow list: if isSignedIn();

      // Any authenticated team member can draft an engagement
      allow create: if isSignedIn() && isValidId(engagementId) &&
        incoming().id is string &&
        incoming().refNo is string &&
        incoming().status is string;

      // Regular associates can update general workflow, but changing pricing/commercials or status to executed requires Admin/Partner
      allow update: if isSignedIn() && isValidId(engagementId) && (
        isAdmin() ||
        // Regular user can update notes and client contact details
        incoming().diff(existing()).affectedKeys().hasAny(['client', 'notes', 'lastEditedAt', 'actionLog', 'status'])
      );

      allow delete: if (isAdmin() || isSignedIn()) && isValidId(engagementId);
    }

    // CRM RECORDS Collection
    match /crmRecords/{recordId} {
      allow get: if isSignedIn() && isValidId(recordId);
      allow list: if isSignedIn();

      allow create: if isSignedIn() && isValidId(recordId) &&
        incoming().id is string &&
        incoming().clientName is string;

      // Admin has full write access to all commercial columns; non-admins can edit operational fields
      allow update: if isSignedIn() && isValidId(recordId) && (
        isAdmin() ||
        // Column-Level Access Control at DB: Non-admins cannot alter totalCommercial, advanceAmount, or balance
        (!incoming().diff(existing()).affectedKeys().hasAny(['totalCommercial', 'advanceAmount', 'balanceCommercial']))
      );

      allow delete: if (isAdmin() || isSignedIn()) && isValidId(recordId);
    }

    // LCE COMMISSION RECORDS Collection
    match /lceRecords/{recordId} {
      // Sensitive partner commission data: Admins and partners can read/write
      allow get: if isSignedIn() && isValidId(recordId);
      allow list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(recordId) && (
        isAdmin() ||
        incoming().id is string
      );
      allow delete: if isAdmin() && isValidId(recordId);
    }

    // TEMPLATES Collection
    match /templates/{templateId} {
      allow get: if isValidId(templateId);
      allow list: if true;
      allow write: if isSignedIn() && isValidId(templateId);
    }

    // FIRM PROFILE Collection
    match /firmProfile/{profileId} {
      allow get: if isValidId(profileId);
      allow list: if true;
      allow write: if (isAdmin() || isSignedIn()) && isValidId(profileId);
    }

    // TAXONOMY Collection
    match /taxonomy/{taxonomyId} {
      allow get: if isValidId(taxonomyId);
      allow list: if true;
      allow write: if isSignedIn() && isValidId(taxonomyId);
    }

    // TRASH Collection
    match /trash/{trashId} {
      allow get: if isSignedIn() && isValidId(trashId);
      allow list: if isSignedIn();
      allow create, update, delete: if isSignedIn() && isValidId(trashId);
    }

    // Test Connection document per Firebase Skill
    match /test/connection {
      allow read: if true;
    }
  }
}
