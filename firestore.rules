rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.]+$');
    }

    // USERS Collection: Real-time multi-browser collaboration
    match /users/{userId} {
      allow read, list: if true;
      allow write: if isValidId(userId);
    }

    // ADMINS Collection
    match /admins/{adminId} {
      allow read, write: if isValidId(adminId);
    }

    // ENGAGEMENTS Collection: Real-time live proposal, invoice & milestone tracking
    match /engagements/{engagementId} {
      allow read, list: if true;
      allow write: if isValidId(engagementId);
    }

    // CRM RECORDS Collection: Real-time 34-column lead pipeline and deals
    match /crmRecords/{recordId} {
      allow read, list: if true;
      allow write: if isValidId(recordId);
    }

    // LCE COMMISSION RECORDS Collection: Real-time partner payouts
    match /lceRecords/{recordId} {
      allow read, list: if true;
      allow write: if isValidId(recordId);
    }

    // TEMPLATES Collection: Real-time scope, conditions & pricing master templates
    match /templates/{templateId} {
      allow read, list: if true;
      allow write: if isValidId(templateId);
    }

    // FIRM PROFILE Collection: Real-time firm branding & letterhead
    match /firmProfile/{profileId} {
      allow read, list: if true;
      allow write: if isValidId(profileId);
    }

    // TAXONOMY Collection: Real-time custom lists & dropdowns
    match /taxonomy/{taxonomyId} {
      allow read, list: if true;
      allow write: if isValidId(taxonomyId);
    }

    // TRASH Collection: Real-time recycle dustbin with millisecond precision
    match /trash/{trashId} {
      allow read, list: if true;
      allow write: if isValidId(trashId);
    }

    // System initialization marker
    match /_system/{docId} {
      allow read, write: if isValidId(docId);
    }

    // Test Connection document per Firebase Skill
    match /test/connection {
      allow read: if true;
    }
  }
}
